private static final double EPSILON = 1e-9;
 
    
    static class Student {
        private String name;
        private int[] quizzes;
 
        public Student(String name, int[] quizzes) {
            this.name = name;
            this.quizzes = quizzes;
        }
 
        public String getName() {
            return name;
        }
 
        public int[] getQuizzes() {
            return quizzes;
        }
 
        public double getAverage() {
            int sum = 0;
            for (int i = 0; i < quizzes.length; i++) {
                sum += quizzes[i];
            }
            return (double) sum / quizzes.length;
        }
    }
 
   
    public static Student[] buildStudents(String[] names, int[][] rawScores) {
        Student[] students = new Student[names.length];
        for (int i = 0; i < names.length; i++) {
            students[i] = new Student(names[i], rawScores[i]);
        }
        return students;
    }
 
    
    public static void sortByAverage(Student[] students) {
        for (int i = 1; i < students.length; i++) {
            Student current = students[i];
            double currentAvg = current.getAverage();
            int j = i - 1;
 
           
            while (j >= 0 && students[j].getAverage() < currentAvg - EPSILON) {
                students[j + 1] = students[j];
                j--;
            }
            students[j + 1] = current;
        }
    }
 
   
    public static int findRank(Student[] sorted, String name) {
        int rank = 1;
        for (int i = 0; i < sorted.length; i++) {
           
            if (i > 0 && sorted[i].getAverage() < sorted[i - 1].getAverage() - EPSILON) {
                rank = i + 1;
            }
            if (sorted[i].getName().equalsIgnoreCase(name)) {
                return rank;
            }
        }
        return -1; 
    }
 
    
    public static void printLeaderboard(Student[] sorted) {
        System.out.println("CLASS LEADERBOARD");
        System.out.printf("%-6s %-10s %-22s %s%n", "Rank", "Name", "Quizzes", "Average");
 
        for (int i = 0; i < sorted.length; i++) {
            Student s = sorted[i];
            int rank = findRank(sorted, s.getName()); 
 
            boolean tied = false;
            if (i > 0 && Math.abs(s.getAverage() - sorted[i - 1].getAverage()) < EPSILON) {
                tied = true;
            }
            if (i < sorted.length - 1
                    && Math.abs(s.getAverage() - sorted[i + 1].getAverage()) < EPSILON) {
                tied = true;
            }
 
            System.out.printf("%-6d %-10s %-22s %.2f%s%n",
                    rank, s.getName(), quizzesToString(s.getQuizzes()),
                    s.getAverage(), tied ? "  (tie)" : "");
        }
    }
 
    private static String quizzesToString(int[] quizzes) {
        String result = "";
        for (int i = 0; i < quizzes.length; i++) {
            result += quizzes[i];
            if (i < quizzes.length - 1) {
                result += ", ";
            }
        }
        return result;
    }
 
    
    public static void main(String[] args) {
        String[] names = {"Alice", "Bob", "Charlie", "Diana", "Ethan", "Fiona"};
 
        
        int[][] rawScores = {
                {88, 92, 79, 95},   
                {75, 80, 85, 70},   
                {90, 85, 95, 90},   
                {92, 88, 90, 90},   
                {60, 72, 68, 80},   
                {85, 90, 80, 95, 88} 
        };
 
        Student[] students = buildStudents(names, rawScores);
 
        sortByAverage(students);
        printLeaderboard(students);
 
       
        System.out.println();
        String[] lookups = {"Charlie", "Diana", "Bob", "Zed"};
        for (int i = 0; i < lookups.length; i++) {
            int rank = findRank(students, lookups[i]);
            if (rank == -1) {
                System.out.println(lookups[i] + " was not found in the class.");
            } else {
                System.out.println(lookups[i] + " is ranked #" + rank);
            }
        }
    }
}




